# Stellar Anchor Service — copy to .env and fill in values

# "testnet" or "mainnet"
STELLAR_ENV=testnet

# Server
PORT=8081

# Stellar keypairs — generate with: stellar-anchor keygen
# Signing key: used to sign SEP-10 challenge transactions
ANCHOR_SIGNING_SEED=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Distribution key: funded account that sends/receives USDC and XLM
DISTRIBUTION_SEED=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC issuer (leave blank to use defaults per network)
# Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ISSUER=

# Horizon URL (leave blank to use canonical URL for the chosen network)
HORIZON_URL=

# Domains
HOME_DOMAIN=slimepay.com
WEB_AUTH_DOMAIN=anchor.slimepay.com

# JWT — generate a strong random string: openssl rand -hex 32
JWT_SECRET=changeme_use_openssl_rand_hex_32

# MongoDB — same connection used by the main server
DATABASE_URL=mongodb://localhost:27017

# Slimepay core backend (for KYC callbacks and payout triggers)
CORE_API_URL=http://localhost:8080
CORE_API_SECRET=changeme
