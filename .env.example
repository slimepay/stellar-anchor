STELLAR_NETWORK=testnet

SEP10_SIGNING_KEY=
DISTRIBUTION_ACCOUNT=
HOME_DOMAIN=slimepay.com
WEB_AUTH_DOMAIN=anchor.slimepay.com

PLATFORM_API_URL=http://localhost:8085
PLATFORM_API_SECRET=
CALLBACK_API_SECRET=
