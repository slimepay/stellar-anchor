# Use keys made for testnet and never reuse them on mainnet.

HOME_DOMAIN=slimepay.com
WEB_AUTH_DOMAIN=anchor.slimepay.com

# SEP-10 signing keypair. The seed goes to SAP only, the public key to the Business Server.
SEP10_SIGNING_SEED=
SEP10_SIGNING_KEY=

# Funded testnet account with a USDC trustline. Only the public key is needed.
DISTRIBUTION_ACCOUNT=

# Shared secrets, at least 32 characters each: openssl rand -hex 32
SEP10_JWT_SECRET=
SEP6_MORE_INFO_JWT_SECRET=
SEP24_INTERACTIVE_JWT_SECRET=
SEP24_MORE_INFO_JWT_SECRET=
CALLBACK_API_SECRET=
PLATFORM_API_SECRET=

# 32 random bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

POSTGRES_USER=anchor
POSTGRES_PASSWORD=

# Dojah, required on mainnet
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Slimepay core, with ANCHOR_NETWORK set to the same network
CORE_API_URL=
CORE_API_SECRET=

NGN_PER_USDC=1500
NGN_PER_XLM=250

ALERT_WEBHOOK_URL=
